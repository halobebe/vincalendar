rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules (permits authenticated students with their UID or custom student ID workspace)
    match /users/{userId} {
      allow get, list: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidId(userId);
      allow delete: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid != null);

      // User Enrolled Courses Subcollection
      match /courses/{courseId} {
        allow get, list: if isAuthenticated();
        allow create: if isAuthenticated()
                      && isValidId(courseId)
                      && request.resource.data.code is string
                      && request.resource.data.name is string;
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // User Deadlines & Canvas LMS Sync Subcollection
      match /deadlines/{deadlineId} {
        allow get, list: if isAuthenticated();
        allow create: if isAuthenticated()
                      && isValidId(deadlineId)
                      && request.resource.data.title is string
                      && request.resource.data.dueDate is string
                      && request.resource.data.dueTime is string;
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }
  }
}
